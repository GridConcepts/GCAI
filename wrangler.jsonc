{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gcai",
  "account_id": "415fc7b609696cce01d5f1d507b5da2d",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ai.gridconcepts.com.au",
      "custom_domain": true
    },
    {
      "pattern": "gridconcepts.com.au/*",
      "zone_name": "gridconcepts.com.au"
    },
    {
      "pattern": "www.gridconcepts.com.au/*",
      "zone_name": "gridconcepts.com.au"
    }
  ]
}
