---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getAuthor } from '../data/authors';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, author, pubDate, updatedDate } = Astro.props;
const byline = getAuthor(author);
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 1180px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.last-updated-on {
				font-style: italic;
			}
			.byline {
				display: flex;
				align-items: center;
				gap: 0.65rem;
				margin-bottom: 1em;
			}
			.byline img {
				width: 40px;
				height: 40px;
				border-radius: 50%;
				object-fit: cover;
				flex-shrink: 0;
			}
			.byline-text {
				display: flex;
				flex-direction: column;
				line-height: 1.3;
			}
			.byline-name {
				font-size: 0.92rem;
				font-weight: 600;
				color: rgb(var(--black));
			}
			.byline-role {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.back {
				display: inline-block;
				margin-bottom: 1.5rem;
				font-size: 0.9rem;
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PXN742" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<Header />
		<main>
			<article>
				<div class="prose">
					<a class="back" href={base}>← All insights</a>
					<div class="title">
						<div class="byline">
							<img src={`${base}${byline.photo}`} alt={byline.name} />
							<div class="byline-text">
								<span class="byline-name">{byline.name}</span>
								<span class="byline-role">{byline.role}</span>
							</div>
						</div>
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
