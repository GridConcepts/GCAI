---
const home = '/';
const links = [
	{ href: '/#approach', label: 'Approach' },
	{ href: '/#services', label: 'Capabilities' },
	{ href: '/#story', label: 'Our story' },
	{ href: '/insights/', label: 'Insights', active: true },
	{ href: '/state-of-ai-report', label: 'The State of AI Report' },
	{ href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
	<div class="bar">
		<a class="logo" href={home} aria-label="Grid Concepts home">
			<span class="logo-mark" aria-hidden="true"></span>
			<span class="logo-text">Grid Concepts</span>
		</a>

		<nav class="desktop-nav" aria-label="Primary">
			{links.map((link) => (
				<a href={link.href} class:list={[{ active: link.active }]}>
					{link.label}
				</a>
			))}
		</nav>

		<a class="cta desktop-cta" href="/#contact">Take the Data Check</a>

		<details class="mobile-menu">
			<summary aria-label="Toggle navigation">
				<span class="burger"></span>
			</summary>
			<nav>
				{links.map((link) => (
					<a href={link.href}>{link.label}</a>
				))}
				<a class="cta" href="/#contact">Take the Data Check</a>
			</nav>
		</details>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid rgba(29, 39, 32, 0.1);
		background: rgba(249, 250, 245, 0.92);
		backdrop-filter: blur(10px);
	}
	.bar {
		margin: 0 auto;
		max-width: 1440px;
		min-height: 72px;
		padding: 0 1.5rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	@media (min-width: 768px) {
		.bar {
			padding: 0 3rem;
		}
	}
	@media (min-width: 1024px) {
		.bar {
			padding: 0 5rem;
		}
	}
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		text-decoration: none;
		flex-shrink: 0;
	}
	.logo-mark {
		width: 0.7rem;
		height: 0.7rem;
		background: #92ad39;
	}
	.logo-text {
		font-family: Inter, system-ui, sans-serif;
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: #1d2720;
	}
	.desktop-nav {
		display: none;
		align-items: center;
		gap: 2rem;
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		font-weight: 500;
	}
	.desktop-nav a {
		color: #465047;
		text-decoration: none;
	}
	.desktop-nav a:hover,
	.desktop-nav a.active {
		color: #6d8226;
	}
	.cta {
		display: inline-flex;
		align-items: center;
		border: 1px solid #92ad39;
		padding: 0.5rem 1rem;
		font-family: Inter, system-ui, sans-serif;
		font-size: 12px;
		font-weight: 600;
		color: #53661c;
		text-decoration: none;
		transition: background 0.2s ease, color 0.2s ease;
		width: fit-content;
	}
	.cta:hover {
		background: #92ad39;
		color: #fff;
	}
	.desktop-cta {
		display: none;
	}
	.mobile-menu {
		position: relative;
	}
	.mobile-menu summary {
		list-style: none;
		cursor: pointer;
		padding: 0.5rem;
	}
	.mobile-menu summary::-webkit-details-marker {
		display: none;
	}
	.burger,
	.burger::before,
	.burger::after {
		display: block;
		width: 20px;
		height: 2px;
		background: #1d2720;
		position: relative;
	}
	.burger::before,
	.burger::after {
		content: '';
		position: absolute;
		left: 0;
	}
	.burger::before {
		top: -6px;
	}
	.burger::after {
		top: 6px;
	}
	.mobile-menu nav {
		position: absolute;
		right: 0;
		top: calc(100% + 0.75rem);
		width: min(86vw, 280px);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1rem 1.1rem 1.15rem;
		border: 1px solid rgba(29, 39, 32, 0.1);
		background: #f9faf5;
		box-shadow: 0 12px 30px rgba(29, 39, 32, 0.12);
		font-family: Inter, system-ui, sans-serif;
		font-size: 14px;
	}
	.mobile-menu nav a {
		color: #465047;
		text-decoration: none;
	}
	@media (min-width: 900px) {
		.desktop-nav,
		.desktop-cta {
			display: flex;
		}
		.mobile-menu {
			display: none;
		}
	}
</style>
